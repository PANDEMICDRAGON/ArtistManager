{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A music project (album, mixtape, EP, LP, or single).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The name of the project." },
        "artistId": { "type": "string", "description": "The ID of the associated artist." },
        "artistName": { "type": "string", "description": "The artist name (denormalized for quick access)." },
        "projectType": { "type": "string", "enum": ["album", "mixtape", "ep", "lp", "single"], "description": "Type of project." },
        "releaseDate": { "type": "string", "format": "date", "description": "Scheduled release date." },
        "status": { "type": "string", "enum": ["planning", "recording", "mixing", "mastering", "released"], "description": "Current project status." },
        "distributionStatus": { "type": "string", "enum": ["not_started", "submitted", "processing", "live", "takedown_requested"], "description": "Status in the distribution pipeline." },
        "isrc": { "type": "string", "description": "International Standard Recording Code." },
        "upc": { "type": "string", "description": "Universal Product Code." },
        "label": { "type": "string", "description": "The record label name." },
        "ownerId": { "type": "string", "description": "The UID of the user who owns this project." }
      },
      "required": ["name", "artistId", "artistName", "projectType", "releaseDate", "status", "distributionStatus", "ownerId"]
    },
    "Artist": {
      "title": "Artist",
      "description": "A music artist managed by the user.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Artist name." },
        "genre": { "type": "string", "description": "Primary genre." },
        "bio": { "type": "string", "description": "Artist biography." },
        "ownerId": { "type": "string", "description": "The UID of the user who manages this artist." }
      },
      "required": ["name", "ownerId"]
    },
    "Task": {
      "title": "Task",
      "description": "A checklist item for a project.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "description": "The ID of the associated project." },
        "title": { "type": "string", "description": "Task title." },
        "description": { "type": "string", "description": "Task description." },
        "status": { "type": "string", "enum": ["todo", "in-progress", "done"], "description": "Current task status." },
        "deadline": { "type": "string", "format": "date", "description": "Task deadline." }
      },
      "required": ["projectId", "title", "status"]
    },
    "CampaignPost": {
      "title": "CampaignPost",
      "description": "A scheduled social media post for a project.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "description": "The ID of the associated project." },
        "platform": { "type": "string", "enum": ["instagram", "twitter", "tiktok", "facebook"], "description": "Target platform." },
        "postType": { "type": "string", "enum": ["feed", "story", "reel", "thread", "video"], "description": "Type of post (e.g., Story, Reel)." },
        "content": { "type": "string", "description": "Post content/caption." },
        "scheduledDate": { "type": "string", "format": "date-time", "description": "When the post should go live." },
        "status": { "type": "string", "enum": ["draft", "scheduled", "posted"], "description": "Current post status." }
      },
      "required": ["projectId", "platform", "postType", "content", "scheduledDate", "status"]
    },
    "Asset": {
      "title": "Asset",
      "description": "A digital asset (audio, image, video) for a project.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string", "description": "The ID of the associated project." },
        "name": { "type": "string", "description": "Asset name." },
        "type": { "type": "string", "enum": ["audio", "image", "video", "document"], "description": "Asset type." },
        "url": { "type": "string", "description": "URL to the asset storage." }
      },
      "required": ["projectId", "name", "type", "url"]
    }
  },
  "firestore": {
    "/artists/{artistId}": {
      "schema": "Artist",
      "description": "Managed artists."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Music projects."
    },
    "/projects/{projectId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks for a project."
    },
    "/projects/{projectId}/campaignPosts/{postId}": {
      "schema": "CampaignPost",
      "description": "Campaign posts for a project."
    },
    "/projects/{projectId}/assets/{assetId}": {
      "schema": "Asset",
      "description": "Assets for a project."
    }
  }
}
